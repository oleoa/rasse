# Copia este ficheiro para .env.local e preenche os valores.
# Nunca commitar .env.local.

# Neon (Postgres serverless) — connection string com sslmode=require
DATABASE_URL=

# Domínio público do bucket Cloudflare R2, com protocolo (ex: https://cdn.exemplo.com).
# Opcional até à Fase 5 — sem ele só existem as imagens locais de seed.
R2_PUBLIC_URL=

# URL público do site (ex: https://oficinarasse.com.br). Sem ele, as metatags
# Open Graph resolvem contra http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# Seed (opcional, só desenvolvimento). Sem SEED_ADMIN_PASSWORD, o seed gera uma
# password aleatória e imprime-a uma única vez.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
