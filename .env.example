# Copia este ficheiro para .env.local e preenche os valores.
# Nunca commitar .env.local.

# --- Base de dados ---

# Neon (Postgres serverless) — connection string com sslmode=require
DATABASE_URL=

# --- Cloudflare R2 (armazenamento de ficheiros) ---

# Account ID do Cloudflare, visível na página do R2
R2_ACCOUNT_ID=
# Token de API do R2, com Object Read & Write limitado ao bucket
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Bucket público: imagens de produto, servidas no site
R2_BUCKET=
# Bucket privado: ficheiros dos clientes, só por URL assinado. NÃO pode ter
# acesso público activado no painel do R2.
R2_PRIVATE_BUCKET=
# Domínio público do bucket, com protocolo. Chega ao browser para montar os URLs
# das imagens, daí o prefixo NEXT_PUBLIC_.
NEXT_PUBLIC_R2_PUBLIC_URL=

# --- Cloudflare Turnstile (anti-spam do formulário de orçamento) ---

# Site key: é pública e chega ao browser, daí o prefixo NEXT_PUBLIC_.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Secret key: só servidor, usada no siteverify.
TURNSTILE_SECRET_KEY=

# --- Autenticação (Auth.js v5) ---

# 32 bytes aleatórios: openssl rand -base64 32
AUTH_SECRET=

# --- Agregação diária (Vercel Cron) ---

# Protege /api/cron/agregar. A Vercel também manda o header x-vercel-cron.
CRON_SECRET=

# --- Site ---

# URL público do site (ex: https://oficinarasse.com.br). Sem ele, as metatags
# Open Graph resolvem contra http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# --- Seed (opcional, só desenvolvimento) ---

# Sem SEED_ADMIN_PASSWORD, o seed gera uma password aleatória e imprime-a uma
# única vez.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
