# Copia este ficheiro para .env.local e preenche os valores.
# Nunca commitar .env.local.

# Neon (Postgres serverless) — connection string com sslmode=require
DATABASE_URL=

# Seed (opcional, só desenvolvimento). Sem SEED_ADMIN_PASSWORD, o seed gera uma
# password aleatória e imprime-a uma única vez.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
